<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/holo_green_light"
    tools:context=".HistoriaClinicaActivity">

    <TextView
        android:id="@+id/tvCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historia Clínica"
        android:background="@android:color/holo_blue_dark"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/imgPaciente"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/imgPaciente"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre: Isaac Torres"
        android:textColor="@android:color/white"
        android:background="@android:color/holo_red_dark"
        android:padding="8dp"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPaciente"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvEdad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edad: 28 años"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvNombre"
        app:layout_constraintTop_toBottomOf="@id/tvNombre"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvDiagnostico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Diagnóstico: Fiebre leve y dolor muscular."
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:background="@android:color/holo_blue_bright"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvNombre"
        app:layout_constraintEnd_toEndOf="@id/tvNombre"
        app:layout_constraintTop_toBottomOf="@id/tvEdad"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar"
        app:layout_constraintStart_toStartOf="@id/tvDiagnostico"
        app:layout_constraintTop_toBottomOf="@id/tvDiagnostico"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actualizar"
        app:layout_constraintStart_toEndOf="@id/btnGuardar"
        app:layout_constraintTop_toTopOf="@id/btnGuardar"
        android:layout_marginStart="16dp" />

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eliminar"
        app:layout_constraintStart_toEndOf="@id/btnActualizar"
        app:layout_constraintTop_toTopOf="@id/btnGuardar"
        android:layout_marginStart="16dp" />

    <ImageButton
        android:id="@+id/imgMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Micrófono"
        android:src="@android:drawable/ic_btn_speak_now"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="HardcodedText" />

    <ImageView
        android:id="@+id/imgLogoClinica"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ute"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnGuardar"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>